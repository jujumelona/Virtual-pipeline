  "notes": {
    "integrity": "source_revision and artifact_sha256 are separate fields. artifact_sha256 is populated only from actual downloaded bytes and is never substituted with a git SHA or package version.",
    "triposr_usage": "Commercial profile requires the pinned TripoSR source commit.",
    "anime_face_detector_usage": "Package version 0.1.0 is pinned exactly; YOLOv3 and HRNetV2 Hugging Face revisions and safetensors SHA256 values are independently pinned and verified before detector construction.",
    "vrm_export": "VRM 1.0 is emitted by the pure-Python pygltflib path; Blender/VRM Add-on is not a runtime dependency.",
    "runtime_contract": "Colab runtime v8 uses prebuilt scikit-image for pinned TripoSR marching cubes rather than compiling torchmcubes. All direct compatibility dependencies and model checks are still verified; artifact SHA256 is only recorded for actual downloaded bytes.",
    "transitive_scope": "commercial_safe flags cover the direct locked components; installed transitive distributions must still be audited from the resolved environment.",
    "triposr_model_integrity": "The Hugging Face model revision is pinned separately from the TripoSR source revision; model.ckpt bytes are verified against model_weight_sha256 before inference.",
    "gradio_usage": "Colab notebook pins Gradio exactly; the published wheel SHA256 is recorded separately from observed artifact_sha256.",
    "dino_runtime_pin": "Upstream TripoSR requests facebook/dino-vitb16 config.json without revision; the local deterministic runner forces this immutable revision.",
    "rembg_model_integrity": "rembg 2.0.85 verifies u2net.onnx with the locked MD5; the pipeline removes MODEL_CHECKSUM_DISABLED from the TripoSR subprocess environment.",
    "makehuman_integrity": "The pinned base.obj is accepted only when its Git blob SHA1 matches the blob at the locked MakeHuman commit; generated template.glb caches are SHA256-bound to that source/version.",
    "marching_cubes_usage": "TripoSR's pinned isosurface.py imports only marching_cubes from torchmcubes. The isolated TripoSR runner supplies a scoped API adapter backed by exact-pinned scikit-image 0.26.0 and returns torch tensors on the original device. No torchmcubes source build is performed.",
    "model_provenance": "Immutable upstream revisions are pinned. Actual downloaded bytes are SHA256-recorded by resolve_snapshot; absent weight hashes remain null."
  }
