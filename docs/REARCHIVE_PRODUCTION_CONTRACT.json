  "visual_lock": {
    "identity": "~717 Ma speculative pre-Cryogenian civilization, genetically engineered human-like bio-android, preserved archive of previous humanity",
    "face": "big translucent mint/lime irises, cute expressive adult-looking anime girl, fine HUD/DNA rings; no plague mask",
    "hair": "black-white-silver twin tails, minimal mint accents, separated front side back and roots",
    "skin": "humanlike with subtle circuits at ear, neck and wrist",
    "outfit": "white gray charcoal preservation archivist uniform over inner life-support suit, flowing sleeves and translucent cape",
    "dna": "chest glass preservation capsule with luminous double helix, hairpin DNA, ear interface, small garment helix seams and backup vial",
    "cryogenic": "subtle frost crystal, specimen ID, ancient recording glyph; restrained",
    "forbidden": [
      "animal ears/tails",
      "plague mask",
      "dominant neon",
      "heavy mecha armor",
      "school or maid outfit",
      "different characters mixed into one body"
    ]
  },
